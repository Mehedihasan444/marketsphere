{
  "name": "marketsphere",
  "version": "1.0.0",
  "private": true,
  "description": "MarketSphere — multi-vendor e-commerce platform (Turborepo monorepo)",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter @marketsphere/web",
    "dev:api": "turbo run dev --filter @marketsphere/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo apps/web/dist apps/api/dist",
    "turbo": "turbo",
    "db:generate": "npm run prisma:generate --workspace @marketsphere/api",
    "db:migrate": "npm run prisma:migrate --workspace @marketsphere/api",
    "db:deploy": "npm run prisma:deploy --workspace @marketsphere/api",
    "db:studio": "npm run prisma:studio --workspace @marketsphere/api",
    "db:push": "npm run prisma:push --workspace @marketsphere/api"
  },
  "devDependencies": {
    "turbo": "^2.11.5"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "core-js": false
  }
}
