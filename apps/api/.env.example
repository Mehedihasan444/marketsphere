# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ─── Database (PostgreSQL / Prisma) ────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketsphere?schema=public"

# ─── Auth ──────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
DEFAULT_PASS=Pass1234

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seed accounts (used by src/app/utils/seeding.ts on boot) ──────────────
ADMIN_EMAIL=admin@marketsphere.com
ADMIN_PASSWORD=admin123
ADMIN_PROFILE_PHOTO=
ADMIN_MOBILE_NUMBER=

VENDOR_EMAIL=vendor@marketsphere.com
VENDOR_PASSWORD=vendor123

# ─── Cloudinary (image storage) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Search (MeiliSearch) ──────────────────────────────────────────────────
MEILISEARCH_HOST=
MEILISEARCH_MASTER_KEY=

# ─── Email (Nodemailer) ────────────────────────────────────────────────────
SENDER_EMAIL=
SENDER_APP_PASS=

# ─── Payments (SSLCommerz) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STORE_ID=
SIGNATURE_KEY=
PAYMENT_URL=
PAYMENT_VERIFY_URL=

# ─── Frontend route (appended to CLIENT_URL to build the reset link) ───────
RESET_PASS_UI_LINK=/reset-password
